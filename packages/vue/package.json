{
  "name": "@fluxgantt/vue",
  "version": "0.1.0",
  "description": "FluxGantt Vue 3 wrapper — <FluxGantt> component + useFluxGantt composable.",
  "license": "MIT",
  "keywords": [
    "gantt",
    "gantt-chart",
    "project-management",
    "scheduling",
    "timeline",
    "typescript",
    "vue",
    "vue3",
    "composable"
  ],
  "homepage": "https://thai-pc.github.io/fluxgantt/docs/frameworks/vue",
  "bugs": {
    "url": "https://github.com/thai-pc/fluxgantt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thai-pc/fluxgantt.git",
    "directory": "packages/vue"
  },
  "author": "Dong Thai (https://github.com/thai-pc)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@fluxgantt/core": "workspace:*"
  },
  "devDependencies": {
    "@fluxgantt/core": "workspace:*",
    "@fluxgantt/eslint-config": "workspace:*",
    "@fluxgantt/tsconfig": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "@vitest/coverage-v8": "2.1.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
