{
  "name": "@fluxgantt/vue",
  "version": "0.0.0",
  "description": "FluxGantt Vue 3 wrapper — <FluxGantt> component + useFluxGantt composable.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@fluxgantt/core": "workspace:*"
  },
  "devDependencies": {
    "@fluxgantt/core": "workspace:*",
    "@fluxgantt/eslint-config": "workspace:*",
    "@fluxgantt/tsconfig": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "@vitest/coverage-v8": "2.1.9",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
