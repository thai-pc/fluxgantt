{
  "name": "@fluxgantt/core",
  "version": "0.1.0",
  "description": "FluxGantt headless engine — state, compute, render, interaction, IO.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./io": {
      "types": "./dist/io/index.d.ts",
      "import": "./dist/io/index.js",
      "require": "./dist/io/index.cjs"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js",
      "require": "./dist/render/index.cjs"
    },
    "./interaction": {
      "types": "./dist/interaction/index.d.ts",
      "import": "./dist/interaction/index.js",
      "require": "./dist/interaction/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo",
    "size": "size-limit"
  },
  "devDependencies": {
    "@fluxgantt/eslint-config": "workspace:*",
    "@fluxgantt/tsconfig": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "@size-limit/esbuild": "^13.0.3",
    "@size-limit/file": "^13.0.3",
    "@vitest/coverage-v8": "2.1.9",
    "fast-check": "^4.9.0",
    "jsdom": "^25.0.1",
    "size-limit": "^13.0.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "peerDependenciesMeta": {
    "@js-temporal/polyfill": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
