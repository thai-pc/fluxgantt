{
  "name": "@fluxgantt/core",
  "version": "0.1.0",
  "description": "FluxGantt headless engine — state, compute, render, interaction, IO.",
  "license": "MIT",
  "keywords": [
    "gantt",
    "gantt-chart",
    "project-management",
    "scheduling",
    "timeline",
    "typescript",
    "headless",
    "svg",
    "canvas",
    "critical-path",
    "tree-shakable"
  ],
  "homepage": "https://thai-pc.github.io/fluxgantt/docs/quick-start",
  "bugs": {
    "url": "https://github.com/thai-pc/fluxgantt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thai-pc/fluxgantt.git",
    "directory": "packages/core"
  },
  "author": "Dong Thai (https://github.com/thai-pc)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./io": {
      "types": "./dist/io/index.d.ts",
      "import": "./dist/io/index.js",
      "require": "./dist/io/index.cjs"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js",
      "require": "./dist/render/index.cjs"
    },
    "./interaction": {
      "types": "./dist/interaction/index.d.ts",
      "import": "./dist/interaction/index.js",
      "require": "./dist/interaction/index.cjs"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "require": "./dist/theme/index.cjs"
    },
    "./responsive": {
      "types": "./dist/responsive/index.d.ts",
      "import": "./dist/responsive/index.js",
      "require": "./dist/responsive/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo",
    "size": "size-limit"
  },
  "devDependencies": {
    "@fluxgantt/eslint-config": "workspace:*",
    "@fluxgantt/tsconfig": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "@size-limit/esbuild": "^14.0.0",
    "@size-limit/file": "^14.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.0",
    "size-limit": "^14.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "peerDependenciesMeta": {
    "@js-temporal/polyfill": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
