{
  "name": "fluxgantt",
  "version": "0.1.0",
  "private": true,
  "description": "The Modern MIT-Licensed Gantt Chart Library \u2014 TypeScript-first, headless, framework-agnostic.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "test:a11y": "playwright test --project=a11y",
    "test:mobile": "playwright test --project=mobile",
    "test:performance": "playwright test --project=performance",
    "test:webkit-canvas-dimension-guard": "playwright test --project=webkit-canvas-dimension-guard",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "size": "turbo run size",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version && node tooling/scripts/sync-version-constant.mjs",
    "release": "turbo run build && changeset publish"
  },
  "pnpm": {
    "overrides": {
      "human-id": "4.1.3"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "rimraf": "^6.0.1",
    "turbo": "^2.11.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.18.1"
  }
}
